# Copy to .env and fill in. Never commit .env. Never paste these into Telegram or Notion.

# --- Required for the first milestone ------------------------------------------------
ANTHROPIC_API_KEY=                 # console.anthropic.com → API keys
TELEGRAM_BOT_TOKEN=                # @BotFather → /newbot
TELEGRAM_ADMIN_USER_IDS=           # your numeric Telegram user ID (comma-separate for more admins)

# --- Notion (Phase 3) -----------------------------------------------------------------
NOTION_TOKEN=                      # notion.so/profile/integrations → internal integration secret
# NOTION_API_VERSION=2025-09-03

# --- GoHighLevel (Phase 4) ------------------------------------------------------------
GHL_PRIVATE_TOKEN=                 # Sub-account → Settings → Private Integrations
GHL_LOCATION_ID=                   # Sub-account → Settings → Business Profile → Location ID

# --- Meta (Phase 3) -------------------------------------------------------------------
META_ACCESS_TOKEN=                 # Business Manager → System Users → generate token
META_PAGE_IDS=                     # comma-separated Facebook Page IDs the team may read
META_IG_USER_IDS=                  # comma-separated Instagram professional account IDs
META_AD_ACCOUNT_IDS=               # comma-separated ad account IDs (without or with act_)
# META_API_VERSION=v23.0

# --- Behaviour ------------------------------------------------------------------------
# EUNARIA_MODEL=claude-opus-5-5              # Atlas
# EUNARIA_SPECIALIST_MODEL=claude-sonnet-5-5  # Sofia, Chloe, Clara, Theo, Luca, Victor, Gabriel, Felix, Enzo, Leo
# EUNARIA_LIGHT_MODEL=claude-haiku-5-5        # Grace, Ava, Maya
# EUNARIA_WEB_SEARCH_MAX_USES=3
# EUNARIA_TIMEZONE=Asia/Manila
# EUNARIA_DAILY_BRIEFING_TIME=08:00
# EUNARIA_OVERDUE_CHECK_TIME=09:00
# EUNARIA_DAILY_COST_LIMIT_USD=25
# EUNARIA_WORKER_THREADS=3
# EUNARIA_ENABLE_WEB_SEARCH=true
# EUNARIA_PROGRESS_UPDATES=true
# EUNARIA_DB_PATH=data/eunaria.db
